{
  "name": "sacre-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "npm run dev --workspace=@sacre-coeur/site",
    "dev:admin": "npm run dev --workspace=@sacre-coeur/admin",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "lint": "eslint apps packages config scripts supabase",
    "test": "node scripts/test.mjs",
    "check": "npm run lint && npm run build && npm test",
    "preview:site": "npm run preview --workspace=@sacre-coeur/site",
    "preview:admin": "npm run preview --workspace=@sacre-coeur/admin",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
